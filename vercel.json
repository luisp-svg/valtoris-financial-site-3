{
  "redirects": [
    {"source": "/tsp-report-card", "destination": "/retirement-report-card", "permanent": true},
    {"source": "/personal-insurance-report-card", "destination": "/personal-insurance", "permanent": true},
    {"source": "/lifestyle-report-card", "destination": "/personal-insurance", "permanent": true},
    {"source": "/commercial-insurance-report-card", "destination": "/commercial-insurance", "permanent": true},
    {"source": "/employee-benefits-report-card", "destination": "/business-report-card", "permanent": true},
    {"source": "/tax-review-report-card", "destination": "/report-card", "permanent": true},
    {"source": "/tax-planning-report-card", "destination": "/report-card", "permanent": true},
    {"source": "/funnel-entry/lifestyle.html", "destination": "/personal-insurance", "permanent": true},
    {"source": "/funnel-entry/commercial.html", "destination": "/commercial-insurance", "permanent": true}
  ],
  "rewrites": [
    {
      "source": "/commercial-trucking-report-card",
      "destination": "/funnel-entry/trucking.html"
    },
    {
      "source": "/student-loan-report-card",
      "destination": "/funnel-entry/student_loan.html"
    },
    {
      "source": "/health-insurance-report-card",
      "destination": "/funnel-entry/health.html"
    },
    {
      "source": "/sms-consent",
      "destination": "/sms-consent.html"
    },
    {
      "source": "/life-insurance",
      "destination": "/sms-consent.html"
    },
    {
      "source": "/sms-terms",
      "destination": "/sms-terms.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/insurance-quote",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/insurance-quote.ts": {
      "maxDuration": 60
    },
    "api/crm/session.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/commercial-trucking-report-card",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/funnel-entry/trucking.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/crm/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/business-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/retirement-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/student-loan-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/credit-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/home-buyer-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/protection-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/financial-assessment",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assessment-results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/comprehensive-discovery",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "dev/licensing-acceptance-fixes-20261112": false,
      "docs/pr44-pr45-release-summary-20261109": false,
      "dev/licensing-revoked-code-guard-20261109": false,
      "dev/licensing-and-report-samples-20261109": false,
      "dev/tac-release-candidate-20261107": false,
      "codex/restore-valtoris-v2": false,
      "codex/academy-migration-audit": false,
      "codex/report-card-booking-retry": false,
      "codex/booking-review-feedback": false,
      "codex/allow-duplicate-booking": false,
      "codex/booking-incomplete-contact": false,
      "codex/booking-slot-recovery": false,
      "codex/report-results-action-plan": false,
      "codex/tac-cleanup-boards": false,
      "codex/tac-household-usability": false,
      "codex/tac-dashboard-navigation": false,
      "codex/tac-dashboard-focus": false,
      "codex/tac-household-focus": false,
      "codex/tac-dashboard-shortcuts": false,
      "codex/tac-horizontal-scroll": false
    }
  }
}
