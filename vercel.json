{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/insurance-quote",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/insurance-quote.ts": {
      "maxDuration": 60
    }
  }
}
