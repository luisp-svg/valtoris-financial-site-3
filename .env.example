# =============================================================================
# Browser-safe (Vite client bundle) — never put service-role here
# =============================================================================
VITE_SITE_NAME=Valtoris Financial
VITE_CALENDLY_REPORT_CARD_URL=https://calendly.com/valtoris/reportcard
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# =============================================================================
# Server-only (Vercel / Node) — NO VITE_ prefix for secrets
# =============================================================================
# Anon key for middleware / session helpers (not the service role)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required by /api/ingest-family-report-card → createSupabaseAdminClient()
# Use sb_secret_* or legacy service_role JWT — never anon / sb_publishable_*
# Missing/misconfigured key → Family CRM ingest fails safely (no results navigation)
# SUPABASE_SERVICE_ROLE_KEY=

# Non-Family Sheets paths (browser helpers / other calculators)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Family Report Card secondary Sheets write (server ingest only).
# Browser Family assessment does NOT post to Sheets.
GOOGLE_SHEETS_CALCULATOR_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Operational contact (also used on /privacy). Not a secret.
LEAD_NOTIFICATION_EMAIL=hello@valtorisfinancial.com

# Failure semantics (Family Report Card):
# - CRM persistence failure → blocks /results
# - Task automation failure → does NOT block /results (visible in CRM Intake)
# - Sheets failure → does NOT block /results (visible in CRM Intake)
#
# Full checklist: docs/sprint-4a3-release-checklist.md

# ---------------------------------------------------------------------------
# Local/dev Auth bootstrap ONLY (npm run bootstrap:dev-auth)
# Loads this file via: node --env-file=.env scripts/bootstrap-dev-auth.mjs
# Shell exports override .env — unset stale shell vars if needed.
# See scripts/README-dev-auth.md — never commit real values.
# Hostname must be exactly cxgiaevervjttbuiramd.supabase.co
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=   # sb_secret_* or legacy service_role JWT
# CONFIRM_DEV_AUTH_BOOTSTRAP=cxgiaevervjttbuiramd
# DEV_OWNER_PASSWORD=
# DEV_ADVISOR_A_PASSWORD=
# DEV_ADVISOR_B_PASSWORD=
# DEV_AUTH_PASSWORD=
